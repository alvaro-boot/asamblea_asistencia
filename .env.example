PORT=3000

# URL de conexión a Postgres en Railway.
# Ejemplo:
# DATABASE_URL=postgres://usuario:password@host:5432/railway?sslmode=require
DATABASE_URL=

# Alternativa sin DATABASE_URL (variables separadas de Railway):
# PGHOST=postgres.railway.internal
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=tu_password
# PGDATABASE=railway

# Supabase (guardar firma base64 en Storage)
# SUPABASE_URL=https://<tu-proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
# SUPABASE_ANON_KEY=<anon_key>
# SUPABASE_PUBLISHABLE_KEY=<publishable_key>
# SUPABASE_BUCKET=firmas

